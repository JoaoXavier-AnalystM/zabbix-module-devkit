# Copy to .env and adjust. Every value here is also the built-in default in
# compose.yml, so the stack starts without this file.
#
#   cp .env.example .env
#
# .env is git-ignored: never commit real credentials.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=zabbix_dev_password

# Read-only role created by postgres/initdb/01-zbx-monitor.sh and used by the
# "PostgreSQL by Zabbix agent 2" template.
ZBX_MONITOR_USER=zbx_monitor
ZBX_MONITOR_PASSWORD=zbx_monitor_dev_password

# --- Zabbix -----------------------------------------------------------------
ZBX_SERVER_NAME=Zabbix Module DevKit
ZBX_HOSTNAME=DevKit-Stack
PHP_TZ=America/Sao_Paulo

# --- Published host ports ---------------------------------------------------
ZBX_WEB_PORT=8080
ZBX_SERVER_PORT=10051
ZBX_AGENT_PORT=10150
ZBX_PASSIVE_ALLOW=true
ZBX_PASSIVESERVERS=zabbix-server
